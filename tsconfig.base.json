{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "declaration": true,
       "declarationDir": "./dist/types",   
       "declarationMap": true,
       "esModuleInterop": true,
       "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "importsNotUsedAsValues": "remove",
    "isolatedModules": true
  }
}
