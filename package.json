{
  "name": "fpdiem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix --ext 'js,ts' .",
    "format": "prettier -w **/* -l",
    "type-check": "tsc --noEmit",
    "compile": "tsc --build --verbose",
    "clean": "rimraf dist",
    "build:ts": "npm run lint && npm run format && npm run compile",
    "build:no-test": "npm run clean && npm run build:ts",
    "build": "npm run test && npm run clean && npm run build:ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-base-typescript": "^1.1.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-require-extensions": "^0.1.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "rimraf": "^4.0.0"
  }
}
